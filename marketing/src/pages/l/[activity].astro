---
import { getCollection } from 'astro:content'
import Lander from '../../layouts/Lander.astro'
import Receipt from '../../components/Receipt.astro'
import FreeClassForm from '../../components/FreeClassForm.astro'
import { landers } from '../../data/landers'
import { OFFER } from '../../data/site'
import { byNewest, isPublished, storyUrl } from '../../lib/stories'

export async function getStaticPaths() {
  // Up to three published stories whose activity matches this lander. The
  // backend sets activity.slug from the same list (STORY_ACTIVITY_SLUGS
  // mirrors landers.ts), so a match is exact, never fuzzy.
  const stories = (await getCollection('stories')).map((e) => e.data).filter(isPublished).sort(byNewest)
  return landers.map((lander) => ({
    params: { activity: lander.slug },
    props: {
      lander,
      examples: stories
        .filter((s) => s.activity.slug === lander.slug)
        .slice(0, 3)
        .map((s) => ({ title: s.title, href: storyUrl(s), credit: s.credit_fraction, subject: s.subject })),
    },
  }))
}

const { lander, examples } = Astro.props
---

<Lander
  title={`${lander.headline} | Optio`}
  description={lander.description}
  ogImage={`/images/og/l-${lander.slug}.png`}
>
  <section class="min-h-screen bg-gradient-to-br from-optio-purple/5 via-white to-optio-pink/5 flex flex-col">
    <div class="max-w-xl mx-auto px-4 sm:px-6 pt-10 sm:pt-16 pb-16 flex-1 w-full">
      <img src="/images/OptioLogo-FullColor.svg" alt="Optio" class="h-8 mb-10" width="120" height="32" />

      <h1 class="text-4xl sm:text-5xl font-bold text-neutral-900 leading-tight mb-4">
        {lander.headline}
      </h1>
      <p class="text-lg text-neutral-500 font-medium leading-relaxed mb-8">
        Optio turns the {lander.activity} you already do into official, WASC-accredited high school
        credit. Capture what you do, and it counts.
      </p>

      <div class="mb-8">
        <Receipt {...lander.receipt} />
      </div>

      <div class="grid grid-cols-2 gap-4 mb-8">
        <div class="rounded-xl border border-neutral-100 bg-neutral-50 p-4">
          <p class="text-sm font-bold text-neutral-900 mb-1">What does it cost?</p>
          <p class="text-sm text-neutral-500 font-medium">{OFFER.freeClassLine}</p>
        </div>
        <div class="rounded-xl border border-neutral-100 bg-neutral-50 p-4">
          <p class="text-sm font-bold text-neutral-900 mb-1">Will my school accept it?</p>
          <p class="text-sm text-neutral-500 font-medium">Transfer Guarantee: full refund if they don't.</p>
        </div>
      </div>

      <FreeClassForm source={`lander_${lander.slug}`} />

      <p class="text-xs text-neutral-500 font-medium mt-6">
        {OFFER.classPriceDetail} Credit is issued through Optio Academy, a WASC-accredited online
        private school.
      </p>

      {examples.length > 0 && (
        <div class="mt-10 pt-8 border-t border-neutral-100">
          <p class="text-sm font-semibold uppercase tracking-wider text-optio-purple mb-3">Real examples</p>
          <ul class="divide-y divide-neutral-100 rounded-xl border border-neutral-100 bg-white">
            {examples.map((ex) => (
              <li>
                <a href={ex.href} data-track="lander_story" class="flex items-center justify-between gap-4 px-4 py-3 group">
                  <span>
                    <span class="block text-sm font-semibold text-neutral-900 group-hover:text-optio-purple transition-colors">{ex.title}</span>
                    <span class="block text-xs text-neutral-500 font-medium mt-0.5">{ex.subject} &middot; {ex.credit}</span>
                  </span>
                  <svg class="w-4 h-4 text-neutral-300 group-hover:text-optio-purple flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>
</Lander>
