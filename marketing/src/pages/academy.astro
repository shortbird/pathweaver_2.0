---
import Marketing from '../layouts/Marketing.astro'
import Receipt from '../components/Receipt.astro'
import TestimonialRow from '../components/TestimonialRow.astro'
import ContactForm from '../components/ContactForm.astro'
import EnrollBand from '../components/EnrollBand.astro'
import FaqList from '../components/FaqList.astro'
import WascBadge from '../components/WascBadge.astro'
import { SITE, OFFER, SOCIAL_LINKS, appLink } from '../data/site'
import { testimonials } from '../data/testimonials'
import { WASC_ACCREDITED_PHRASE } from '../data/accreditation'
import { HOW_IT_WORKS } from '../data/howItWorks'

// One idea, seven bands: the offer, who it fits, how credit is earned, why
// it is official, the math, the questions, the button. The page speaks to
// the student in the second person; money lines carry no pronoun so they read
// the same to whoever pays. Every number comes from OFFER.
//
// Tuition-to-credit rule confirmed 2026-09-17: every $100 of tuition is one
// credit, $50/month is six credits a year, extra credits are $100 each, and
// students 13+ earn high school credit. Still open: whether an unused balance
// rolls across years, and how the family cap divides among several teens.

const enrollUrl = appLink(OFFER.academyEnrollPath)

const SCREENSHOTS = [
  {
    src: 'https://auth.optioeducation.com/storage/v1/object/public/site-assets/screenshots/basketball.png',
    alt: 'A basketball project in the Optio app',
  },
  {
    src: 'https://auth.optioeducation.com/storage/v1/object/public/site-assets/screenshots/stop_motion.png',
    alt: 'A stop motion animation project in the Optio app',
  },
]

// The money as a picture: the price, the pace, the finish line. The tiles
// carry the arithmetic so the copy does not have to.
const LADDER = [
  { value: OFFER.academyMonthly, unit: 'a month', label: 'per student' },
  { value: OFFER.academyCreditsPerYearNumeral, unit: 'credits a year', label: `every ${OFFER.academyPerCredit} of tuition is one credit` },
  { value: OFFER.academyDiplomaCredits, unit: 'credits', label: 'a diploma, in four years' },
]

const TUITION_POINTS = [
  `Every ${OFFER.academyPerCredit} of tuition is one high school credit.`,
  `Capped at ${OFFER.academyFamilyCap} a month per family.`,
  'Under 13? Same price. Credit starts counting at 13.',
  `Want to finish sooner? Extra credits are ${OFFER.academyPerCredit} each.`,
]

const SUPPORT_POINTS = [
  'Message your Optio teacher anytime.',
  'A weekly video check-in.',
  'Support and accountability, all year.',
]

const FITS = [
  {
    title: 'Enrolled at another school',
    body: 'Stay where you are. Earn Optio credit for the training, the build, the business on the side.',
  },
  {
    title: 'Homeschooling',
    body: 'Keep your freedom. Optio reviews the work and keeps the official record.',
  },
  {
    title: 'Only Optio',
    body: `Make Optio your school. ${OFFER.academyDiplomaCredits} credits, an accredited diploma, at your own pace from anywhere.`,
  },
]

const FAQS = [
  {
    q: 'Is the diploma real? Will colleges accept it?',
    a: 'Yes. Optio Academy is accredited by ACS WASC, the same commission that accredits thousands of public and private schools. Colleges and employers accept the transcript and diploma like any other school\'s.',
  },
  {
    q: 'Can I stay enrolled at my current school?',
    a: 'Yes. Stay full time at your school, homeschool, or make Optio your only school. Either way the credit is yours, on an official transcript.',
  },
  {
    q: 'How is credit earned without tests and seat time?',
    a: 'Credit is based on evidence of learning, not hours in a chair. You document the work in the Optio app, an Optio teacher reviews it, and the credit goes on your transcript. A finished game, a training log, a business plan: real work is the exam.',
  },
  {
    q: `Can I earn more than ${OFFER.academyCreditsPerYear} credits a year?`,
    a: `Yes. Tuition covers ${OFFER.academyCreditsPerYear} credits a year, the standard pace for a diploma in four years. Credits beyond that are ${OFFER.academyPerCredit} each. Tuition is capped at ${OFFER.academyFamilyCap} a month per family.`,
  },
  {
    q: "Can I get a teacher's help?",
    a: `Yes. Add a dedicated Optio teacher for ${OFFER.academyTeacherSupportMonthly} a month, tuition included. Message them anytime, and meet on a weekly video check-in for support and accountability.`,
  },
  {
    q: 'When can I start?',
    a: 'Any day. Admissions are rolling and the work is self-paced, in any time zone. Enroll and start right away.',
  },
]

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'School',
    name: 'Optio Academy',
    url: `${SITE.url}/academy`,
    description: `An accredited online high school, with enrollment from kindergarten. ${WASC_ACCREDITED_PHRASE}. Credit is based on evidence of learning, with rolling admissions and self-paced learning from anywhere in the world.`,
    email: SITE.academyEmail,
    sameAs: SOCIAL_LINKS.map((s) => s.href),
    parentOrganization: { '@type': 'Organization', name: 'Optio', url: SITE.url },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: FAQS.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
]
---

<Marketing
  title="Optio Academy | A WASC-Accredited Online High School"
  description={`Optio Academy is a WASC-accredited online high school that turns what you already do into credit on an official transcript. ${OFFER.academyMonthly} a month, every ${OFFER.academyPerCredit} of tuition is one credit, from anywhere in the world.`}
  ogImage="/images/og/academy.png"
  schema={schema}
>
  <!-- ========== HERO: the offer in one screen ========== -->
  <section class="bg-gradient-primary text-white overflow-hidden">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 pt-14 sm:pt-20 pb-14 sm:pb-20">
      <div class="grid md:grid-cols-[1.2fr_1fr] gap-10 lg:gap-14 items-center">
        <div class="text-center md:text-left">
          <p class="text-sm font-semibold uppercase tracking-wider text-white/80 mb-4">Optio Academy</p>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight mb-5">{SITE.brandLine}</h1>
          <p class="text-lg sm:text-xl text-white/90 font-medium leading-relaxed mb-8">
            Optio Academy is a WASC-accredited online high school. Turn what you already do into
            credit on an official transcript: document your work, an Optio teacher reviews it, and
            it counts. From anywhere in the world.
          </p>
          <div class="flex flex-col items-center md:items-start gap-4">
            <a href={enrollUrl} data-track="hero_enroll" class="btn-inverse btn-lg whitespace-nowrap">Enroll now</a>
            <p class="text-sm text-white/80 font-medium">
              {OFFER.academyMonthly} USD a month. Questions first?
              <a href="#get-info" data-track="hero_discovery_call" class="underline font-semibold text-white hover:text-white/80 transition-colors">Schedule a call</a>.
            </p>
          </div>
        </div>

        <div class="w-full max-w-sm mx-auto">
          <Receipt
            activity="Trained for a half marathon"
            course="Physical Education"
            credit="0.5 credit"
            image="https://images.pexels.com/photos/17979480/pexels-photo-17979480.jpeg?auto=compress&cs=tinysrgb&w=800"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ========== FITS ANY SCHOOL, AND WHO SAYS SO ========== -->
  <section class="bg-neutral-50 border-y border-neutral-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-16 sm:py-20">
      <h2 class="text-3xl sm:text-4xl font-bold text-neutral-900 text-center mb-10">
        Optio fits around any school, or stands alone.
      </h2>
      <div class="grid md:grid-cols-3 gap-5">
        {FITS.map((f) => (
          <div class="rounded-2xl border border-neutral-100 bg-white p-6">
            <h3 class="text-lg font-bold text-neutral-900 mb-2">{f.title}</h3>
            <p class="text-neutral-500 font-medium leading-relaxed">{f.body}</p>
          </div>
        ))}
      </div>
      <div class="space-y-5 mt-10">
        {testimonials.slice(0, 2).map((t) => (
          <TestimonialRow {...t} class="bg-white border border-neutral-100 shadow-sm" />
        ))}
      </div>
    </div>
  </section>

  <!-- ========== HOW CREDIT IS EARNED ========== -->
  <section id="how-it-works" class="bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-16 sm:py-20">
      <h2 class="text-3xl sm:text-4xl font-bold text-neutral-900 text-center mb-12">How credit is earned</h2>
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <ol class="space-y-8">
          {HOW_IT_WORKS.map((step, i) => (
            <li class="flex items-start gap-5">
              <span class="flex-shrink-0 w-10 h-10 rounded-full bg-optio-purple text-white flex items-center justify-center text-base font-bold">
                {i + 1}
              </span>
              <div class="pt-1">
                <p class="text-lg font-bold text-neutral-900 mb-1">{step.title}</p>
                <p class="text-neutral-500 font-medium leading-relaxed">{step.body}</p>
              </div>
            </li>
          ))}
        </ol>
        <div class="flex justify-center items-start gap-4">
          {SCREENSHOTS.map((s) => (
            <div class="w-[160px] sm:w-[190px] bg-neutral-900 rounded-[2rem] p-1.5 shadow-2xl">
              <img src={s.src} alt={s.alt} class="rounded-[1.6rem] w-full aspect-[9/19] object-cover object-top" loading="lazy" />
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ========== TRUST: accreditation and the Head of School ========== -->
  <section class="bg-neutral-50 border-y border-neutral-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-16 sm:py-20">
      <div class="grid md:grid-cols-[auto_1fr] gap-10 items-center mb-14">
        <div class="mx-auto md:mx-0">
          <WascBadge variant="card" class="max-w-xs" />
        </div>
        <div>
          <h2 class="text-3xl sm:text-4xl font-bold text-neutral-900 mb-4">The credit is official, wherever you live.</h2>
          <p class="text-lg text-neutral-500 font-medium leading-relaxed">
            Optio Academy is accredited by ACS WASC, the same commission that accredits thousands
            of US public and private schools. Your transcript and diploma read like any American
            high school's.
          </p>
        </div>
      </div>

      <div class="max-w-3xl mx-auto bg-white rounded-2xl border border-neutral-100 p-6 sm:p-8">
        <div class="flex flex-col sm:flex-row gap-6 sm:items-center">
          <img
            src="/images/head-of-school.png"
            alt="Dr. Tanner Bowman, Head of School"
            class="w-20 h-20 rounded-full bg-neutral-50 ring-2 ring-optio-purple/20 flex-shrink-0"
            width="80"
            height="80"
            loading="lazy"
          />
          <div class="flex-1">
            <p class="text-neutral-700 font-medium leading-relaxed mb-3">
              "The teenagers I meet are already educating themselves. I started Optio Academy so
              that counts, officially."
            </p>
            <p class="font-bold text-neutral-900">
              Dr. Tanner Bowman
              <span class="font-medium text-neutral-500">&middot; Head of School</span>
            </p>
            <a href={`mailto:${SITE.academyEmail}`} data-track="head_of_school_email" class="text-sm font-medium text-optio-purple hover:underline">
              Email Dr. Bowman
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== TUITION: the price, the pace, the finish line ========== -->
  <section id="pricing" class="bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-16 sm:py-24">
      <div class="text-center mb-12">
        <p class="text-sm font-semibold uppercase tracking-wider text-optio-purple mb-3">Tuition</p>
        <h2 class="text-3xl sm:text-4xl font-bold text-neutral-900 leading-tight">
          {OFFER.academyMonthly} a month becomes a diploma in four years.
        </h2>
      </div>

      <ol class="flex flex-col md:flex-row items-center gap-3 md:gap-4">
        {LADDER.map((t, i) => (
          <>
            {i > 0 && (
              <li aria-hidden="true" class="text-optio-purple/40 flex-shrink-0">
                <svg class="w-7 h-7 rotate-90 md:rotate-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </li>
            )}
            <li class="w-full md:flex-1 rounded-2xl border border-neutral-100 bg-neutral-50 p-6 text-center">
              <p class="text-4xl sm:text-5xl font-bold text-neutral-900 leading-none">{t.value}</p>
              <p class="text-xs font-semibold uppercase tracking-wider text-optio-purple mt-3">{t.unit}</p>
              <p class="text-sm text-neutral-500 font-medium mt-1">{t.label}</p>
            </li>
          </>
        ))}
      </ol>

      <div class="grid md:grid-cols-2 gap-5 mt-10">
        <div class="rounded-2xl border border-optio-purple/20 bg-gradient-to-br from-optio-purple/5 to-optio-pink/5 p-6 sm:p-8 flex flex-col">
          <p class="text-sm font-semibold uppercase tracking-wider text-optio-purple mb-2">Tuition</p>
          <p class="text-3xl font-bold text-neutral-900 mb-5">
            {OFFER.academyMonthly}<span class="text-base font-medium text-neutral-500"> a month per student</span>
          </p>
          <ul class="space-y-2.5 mb-7 flex-1">
            {TUITION_POINTS.map((line) => (
              <li class="flex items-start gap-2.5 text-neutral-700 font-medium leading-relaxed">
                <svg class="w-5 h-5 mt-0.5 text-optio-purple flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <span>{line}</span>
              </li>
            ))}
          </ul>
          <a href={enrollUrl} data-track="pricing_enroll" class="btn-primary self-start">Enroll now</a>
        </div>

        <div class="rounded-2xl border border-neutral-100 bg-neutral-50 p-6 sm:p-8 flex flex-col">
          <p class="text-sm font-semibold uppercase tracking-wider text-optio-purple mb-2">Want extra support?</p>
          <p class="text-3xl font-bold text-neutral-900 mb-5">
            {OFFER.academyTeacherSupportMonthly}<span class="text-base font-medium text-neutral-500"> a month, tuition included</span>
          </p>
          <ul class="space-y-2.5 mb-7 flex-1">
            {SUPPORT_POINTS.map((line) => (
              <li class="flex items-start gap-2.5 text-neutral-700 font-medium leading-relaxed">
                <svg class="w-5 h-5 mt-0.5 text-optio-purple flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <span>{line}</span>
              </li>
            ))}
          </ul>
          <a href="#get-info" data-track="pricing_support_call" class="text-sm font-medium text-optio-purple hover:underline self-start">
            Add an Optio teacher: schedule a call
          </a>
        </div>
      </div>

      <p class="text-xs text-neutral-500 font-medium text-center mt-6">All prices in US dollars.</p>
    </div>
  </section>

  <!-- ========== FAQ ========== -->
  <section id="faq" class="bg-neutral-50 border-y border-neutral-100">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 py-16 sm:py-20">
      <h2 class="text-3xl sm:text-4xl font-bold text-neutral-900 text-center mb-10">Common questions</h2>
      <FaqList faqs={FAQS} />
      <p class="text-xs text-neutral-500 mt-10 font-medium text-center">
        Optio Academy is operated by Optio, LLC. Optio Academy admits students of any race, color,
        national origin, religion, or background, and extends to all students every right, privilege,
        program, and activity of the school. See the
        <a href={`${SITE.appUrl}/academy-agreement`} class="underline hover:text-optio-purple">Participant &amp; Parent Agreement</a>
        and
        <a href={`${SITE.appUrl}/academy-handbook`} class="underline hover:text-optio-purple">Participant Handbook</a>.
      </p>
    </div>
  </section>

  <!-- ========== ENROLL, OR ASK FIRST ========== -->
  <EnrollBand track="academy_enroll" />

  <ContactForm
    source="academy"
    heading="Questions first? Schedule a call."
    subheading="Tell us a little about yourself and we'll reach out to set up a time to talk."
    placeholder="Grade level, interests, and anything else you'd like us to know"
    choicesLabel="Which setup fits you?"
    choices={['Enrolled at another school', 'Homeschooling', 'Only Optio', 'Not sure yet']}
    buttonLabel="Request a call"
  />
</Marketing>
