---
import Marketing from '../../layouts/Marketing.astro'
import Breadcrumbs from '../../components/Breadcrumbs.astro'
import { getCollection, render } from 'astro:content'
import { SITE } from '../../data/site'
import { ORG_ID, PERSON_ID, absolute, breadcrumbNode, graph, organizationNode, personNode } from '../../data/schema'

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }: any) => !data.draft)
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }))
}

const { post } = Astro.props
const { Content } = await render(post)

const url = `${SITE.url}/blog/${post.id}/`
const ogImage = post.data.ogImage || '/images/og/blog.png'
const published = post.data.pubDate
const modified = post.data.updatedDate ?? post.data.pubDate
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Blog', href: '/blog/' },
  { name: post.data.title, href: `/blog/${post.id}/` },
]

// One graph: the post points at the site-wide Organization and Person nodes
// by @id instead of redeclaring them, and the breadcrumb trail matches the
// visible one above the title.
const schema = [
  graph(
    organizationNode(),
    personNode(),
    {
      '@type': 'BlogPosting',
      '@id': `${url}#post`,
      headline: post.data.title,
      description: post.data.description,
      image: [absolute(ogImage)],
      url,
      datePublished: published.toISOString(),
      dateModified: modified.toISOString(),
      author: { '@id': PERSON_ID },
      publisher: { '@id': ORG_ID },
      mainEntityOfPage: { '@type': 'WebPage', '@id': url },
      inLanguage: 'en-US',
      isAccessibleForFree: true,
    },
    breadcrumbNode(crumbs)
  ),
]
---

<Marketing
  title={`${post.data.title} | Optio`}
  description={post.data.description}
  ogImage={ogImage}
  ogType="article"
  schema={schema}
  publishedTime={published}
  modifiedTime={modified}
>
  <article class="bg-white">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 pt-10 sm:pt-14 pb-20">
      <Breadcrumbs items={crumbs} class="mb-8" />
      <p class="text-xs text-neutral-500 font-semibold uppercase tracking-wider mb-4">
        <time datetime={published.toISOString()}>
          {published.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
      </p>
      <h1 class="text-3xl sm:text-5xl font-bold text-neutral-900 leading-tight mb-6">{post.data.title}</h1>
      <div class="flex items-center gap-3 pb-8 mb-8 border-b border-neutral-100">
        <img
          src="/images/head-of-school.png"
          alt={post.data.author}
          class="w-10 h-10 rounded-full bg-white ring-1 ring-neutral-100"
          width="40"
          height="40"
        />
        <div>
          <p class="text-sm font-semibold text-neutral-900">{post.data.author}</p>
          <p class="text-xs text-neutral-500 font-medium">{post.data.authorTitle}</p>
        </div>
      </div>

      <div class="prose-optio">
        <Content />
      </div>

      <div class="mt-12 rounded-2xl bg-gradient-primary text-white p-8 text-center">
        <p class="text-xl font-bold mb-2">Real credit for real life.</p>
        <p class="text-white/80 font-medium mb-5">Your first class is free.</p>
        <a href="/academy#free-class" data-track="blog_post_cta" class="btn-inverse">Try a free class</a>
      </div>

      <p class="mt-8 text-sm text-neutral-500 font-medium">
        Want to see what this looks like in practice?
        <a href="/stories/" class="text-optio-purple underline">Read the stories</a>: real submissions that became credit, with the reviewer's feedback verbatim.
      </p>
    </div>
  </article>
</Marketing>
