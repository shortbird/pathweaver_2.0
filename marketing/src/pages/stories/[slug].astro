---
/**
 * One story. The student's evidence first, then how Optio works for a
 * visitor who has never heard of it, then the facts, then the long form.
 * Every section heading is a question a parent (or an answer engine) would
 * ask about the story. Credit appears once, in the receipt, with the XP rule
 * spelled out beside it.
 *
 * Fixture entries (STORIES_SOURCE=fixture, never on Render) render here
 * with noindex so the layout can be checked on a developer's machine.
 */
import { getCollection } from 'astro:content'
import { getImage } from 'astro:assets'
import Marketing from '../../layouts/Marketing.astro'
import Breadcrumbs from '../../components/Breadcrumbs.astro'
import Receipt from '../../components/Receipt.astro'
import FaqList from '../../components/FaqList.astro'
import FreeClassForm from '../../components/FreeClassForm.astro'
import StoryHero from '../../components/stories/StoryHero.astro'
import HowItWorksStrip from '../../components/stories/HowItWorksStrip.astro'
import StoryFacts from '../../components/stories/StoryFacts.astro'
import TaskList from '../../components/stories/TaskList.astro'
import EvidenceGrid from '../../components/stories/EvidenceGrid.astro'
import CriteriaList from '../../components/stories/CriteriaList.astro'
import RelatedStories from '../../components/stories/RelatedStories.astro'
import { OFFER } from '../../data/site'
import { creditExplainer } from '../../data/howItWorks'
import { ORG_ID, PERSON_ID, absolute, breadcrumbNode, faqNode, graph, organizationNode, personNode, videoNode } from '../../data/schema'
import type { Story } from '../../data/stories.schema'
import {
  cardProps,
  evidenceBesidesHero,
  formatDate,
  heroOf,
  heroStill,
  isPublished,
  isoDuration,
  landerFor,
  listable,
  ogImagePath,
  related,
  sectionsByKind,
  storyUrl,
  subjectUrl,
  xpPerCredit,
  SETTING_LABEL,
} from '../../lib/stories'

export async function getStaticPaths() {
  const entries = await getCollection('stories')
  const all = entries.map((e) => e.data)
  const visible = listable(all)
  const counts = new Map<string, number>()
  for (const s of visible) counts.set(s.subject_slug, (counts.get(s.subject_slug) ?? 0) + 1)
  const hubSlugs = [...counts.entries()].filter(([, n]) => n >= 2).map(([slug]) => slug)
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: {
      story: entry.data,
      relatedStories: related(entry.data, visible).map(cardProps),
      hubSlugs,
    },
  }))
}

interface Props {
  story: Story
  relatedStories: ReturnType<typeof cardProps>[]
  hubSlugs: string[]
}
const { story, relatedStories, hubSlugs } = Astro.props
const hubs = new Set(hubSlugs)
const published = isPublished(story)
const sections = sectionsByKind(story)
const lander = landerFor(story)
const hero = heroOf(story)
const still = heroStill(story)
const moreEvidence = evidenceBesidesHero(story)
const url = absolute(storyUrl(story))
const ogImage = ogImagePath(story)
const hasHub = hubs.has(story.subject_slug)

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Stories', href: '/stories/' },
  ...(hasHub ? [{ name: story.subject, href: subjectUrl(story.subject_slug) }] : []),
  { name: story.title, href: storyUrl(story) },
]

// Article.image: the hero's still (the image, or a video's poster) as
// astro:assets built it, plus the OG card. Both absolute; Google requires it.
const stillBuilt = still ? await getImage({ src: still, inferSize: true, width: 1200, format: 'jpg' }) : null
const images = [stillBuilt ? absolute(stillBuilt.src) : null, absolute(ogImage)].filter(Boolean)

const video =
  hero?.type === 'video'
    ? videoNode({
        id: `${url}#video`,
        name: story.title,
        description: hero.caption || hero.alt || story.dek,
        contentUrl: hero.url,
        thumbnailUrl: stillBuilt ? absolute(stillBuilt.src) : absolute(ogImage),
        uploadDate: story.published_at.toISOString(),
        duration: isoDuration(hero.duration_seconds),
      })
    : null

const article = {
  '@type': 'Article',
  '@id': `${url}#article`,
  headline: story.title,
  description: story.dek,
  image: images,
  ...(video ? { video: { '@id': video['@id'] } } : {}),
  datePublished: story.published_at.toISOString(),
  dateModified: story.updated_at.toISOString(),
  author: { '@id': PERSON_ID },
  publisher: { '@id': ORG_ID },
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  url,
  articleSection: 'Stories',
  inLanguage: 'en-US',
  isAccessibleForFree: true,
  about: [
    { '@type': 'Thing', name: story.subject },
    { '@type': 'Thing', name: story.activity.label },
  ],
  keywords: [story.subject, story.activity.label, 'high school credit', 'Optio Academy'].join(', '),
}

const schema = [
  graph(
    organizationNode(),
    personNode(),
    article,
    ...(video ? [video] : []),
    breadcrumbNode(crumbs),
    ...(story.faq.length > 0 ? [faqNode(story.faq, `${url}#faq`)] : [])
  ),
]

// Where "What it counted for" sends a parent: the matching lander, else the
// subject hub, else the Academy page.
const counted = lander
  ? {
      href: `/l/${lander.slug}/`,
      eyebrow: `Your ${lander.activity} could count too`,
      headline: lander.headline,
      detail: `How ${lander.activity} becomes ${lander.subject} credit. ${OFFER.freeClassLine}`,
      track: 'story_lander',
    }
  : hasHub
    ? {
        href: subjectUrl(story.subject_slug),
        eyebrow: `More ${story.subject} stories`,
        headline: `Other students who earned ${story.subject} credit`,
        detail: 'Every story in this subject, and what counted.',
        track: 'story_subject_hub',
      }
    : {
        href: '/academy',
        eyebrow: 'Your kid\'s work could count too',
        headline: 'How Optio Academy turns real work into credit',
        detail: `An accredited online private school built around what students already do. ${OFFER.freeClassLine}`,
        track: 'story_academy',
      }
---

<Marketing
  title={`${story.title} | Optio`}
  description={story.dek}
  ogImage={ogImage}
  ogType="article"
  schema={schema}
  noindex={!published}
  publishedTime={story.published_at}
  modifiedTime={story.updated_at}
>
  <article>
    <!-- ========== HEADER ========== -->
    <header class="bg-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 pt-10 sm:pt-14 pb-8">
        <Breadcrumbs items={crumbs} class="mb-6" />
        {!published && (
          <p class="mb-6 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm font-semibold text-amber-800">
            {story.status === 'fixture'
              ? 'Fixture story. This page exists to check the layout and is never published.'
              : 'Draft. This story is in review and is not on the live site.'}
          </p>
        )}
        <p class="text-xs text-neutral-500 font-semibold uppercase tracking-wider mb-4">
          {story.subject} &middot; {SETTING_LABEL[story.student.setting]}
        </p>
        <h1 class="text-3xl sm:text-5xl font-bold text-neutral-900 leading-tight mb-5 max-w-3xl">{story.title}</h1>
        <p class="text-lg sm:text-xl text-neutral-500 font-medium leading-relaxed mb-8 max-w-3xl">{story.dek}</p>
        <div class="flex items-center gap-3">
          <img
            src="/images/head-of-school.png"
            alt={story.author.name}
            class="w-10 h-10 rounded-full bg-white ring-1 ring-neutral-100"
            width="40"
            height="40"
          />
          <div>
            <p class="text-sm font-semibold text-neutral-900">{story.author.name}</p>
            <p class="text-xs text-neutral-500 font-medium">
              {story.author.title} &middot; <time datetime={story.published_at.toISOString()}>{formatDate(story.published_at)}</time>
            </p>
          </div>
        </div>
      </div>
    </header>

    <!-- ========== THE WORK ========== -->
    <section class="bg-white" aria-label="The student's work">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 pb-10 space-y-8">
        {hero ? (
          <StoryHero hero={hero} fallbackAlt={story.receipt.activity} />
        ) : (
          <Receipt {...story.receipt} class="max-w-sm" />
        )}
        <HowItWorksStrip />
        <StoryFacts story={story} hubSlugs={hubs} />
      </div>
    </section>

    <!-- ========== BODY ========== -->
    <div class="bg-neutral-50 border-t border-neutral-100">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 py-14 sm:py-16 space-y-14 sm:space-y-16">
        {sections.whatTheyDid && (
          <section aria-labelledby="what-they-did">
            <h2 id="what-they-did" class="text-2xl sm:text-3xl font-bold text-neutral-900 mb-5">What the student did</h2>
            <div class="prose-optio" set:html={sections.whatTheyDid.body_html ?? ''} />
          </section>
        )}

        {sections.tasks && sections.tasks.rows.length > 0 && (
          <section aria-labelledby="the-tasks">
            <h2 id="the-tasks" class="text-2xl sm:text-3xl font-bold text-neutral-900 mb-2">The tasks</h2>
            <p class="text-neutral-500 font-medium mb-5">
              Each task was submitted and reviewed on its own. XP is earned per task; the credit is the sum.
            </p>
            <TaskList rows={sections.tasks.rows} />
          </section>
        )}

        {moreEvidence.length > 0 && (
          <section aria-labelledby="evidence">
            <h2 id="evidence" class="text-2xl sm:text-3xl font-bold text-neutral-900 mb-2">
              {hero ? 'More of the evidence' : 'What the student submitted as evidence'}
            </h2>
            <p class="text-neutral-500 font-medium mb-6">
              Shown as submitted, minus anything the family did not agree to share.
            </p>
            <EvidenceGrid items={moreEvidence} />
          </section>
        )}

        {sections.criteria && sections.criteria.criteria.length > 0 && (
          <section aria-labelledby="criteria">
            <h2 id="criteria" class="text-2xl sm:text-3xl font-bold text-neutral-900 mb-2">What the teacher checked</h2>
            <p class="text-neutral-500 font-medium mb-6">
              The criteria belong to the task. A licensed Optio teacher marked each one from the evidence.
            </p>
            <CriteriaList criteria={sections.criteria.criteria} />
          </section>
        )}

        <section aria-labelledby="what-it-counted-for">
          <h2 id="what-it-counted-for" class="text-2xl sm:text-3xl font-bold text-neutral-900 mb-5">What it counted for</h2>
          {sections.whatItCountedFor && (
            <div class="prose-optio" set:html={sections.whatItCountedFor.body_html ?? ''} />
          )}
          <p class="mt-5 text-neutral-700 font-medium leading-relaxed">{creditExplainer(xpPerCredit(story))}</p>
          <div class="mt-8 grid gap-5 sm:grid-cols-2 items-stretch">
            <Receipt {...story.receipt} />
            <a
              href={counted.href}
              data-track={counted.track}
              class="flex flex-col justify-between gap-4 rounded-2xl border border-optio-purple/20 bg-gradient-to-br from-optio-purple/5 to-optio-pink/5 p-5 group"
            >
              <span>
                <span class="block text-xs font-semibold uppercase tracking-wider text-optio-purple mb-1">{counted.eyebrow}</span>
                <span class="block text-lg font-bold text-neutral-900 group-hover:text-optio-purple transition-colors">{counted.headline}</span>
                <span class="block text-sm text-neutral-500 font-medium mt-1">{counted.detail}</span>
              </span>
              <span class="inline-flex items-center gap-1 text-sm font-semibold text-optio-purple">
                Read more
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </span>
            </a>
          </div>
        </section>

        {story.faq.length > 0 && (
          <section aria-labelledby="questions">
            <h2 id="questions" class="text-2xl sm:text-3xl font-bold text-neutral-900 mb-2">Questions about Optio</h2>
            <FaqList faqs={story.faq} />
          </section>
        )}

        <p class="text-sm text-neutral-500 font-medium border-t border-neutral-200 pt-6">
          Stories are written from real submissions on Optio. Student details are anonymized unless a family has
          recorded consent, and evidence is shown as submitted, minus anything a family did not agree to share.
          Published {formatDate(story.published_at)}{story.updated_at.valueOf() > story.published_at.valueOf() ? `, updated ${formatDate(story.updated_at)}` : ''}.
        </p>
      </div>
    </div>
  </article>

  <RelatedStories
    stories={relatedStories}
    subject={story.subject}
    subjectSlug={hasHub ? story.subject_slug : null}
  />

  <!-- ========== CTA ========== -->
  <section class="bg-gradient-primary text-white">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 py-16 sm:py-20 text-center">
      <h2 class="text-3xl sm:text-4xl font-bold mb-3 leading-tight">Your kid's {lander ? lander.activity : 'real work'} could be next.</h2>
      <p class="text-white/80 font-medium mb-8">
        One semester-length class, 0.5 credit, reviewed by a licensed teacher. {OFFER.freeClassLine}
      </p>
      <div class="max-w-md mx-auto [&_.form-note]:text-white/60 [&_.form-note]:text-center [&_.form-error]:text-center">
        <FreeClassForm source={`story_${story.slug}`} inverse />
      </div>
    </div>
  </section>
</Marketing>
