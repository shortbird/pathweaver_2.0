---
import { SITE, appLink } from '../data/site'

const links = [
  { label: 'Academy', href: '/academy' },
  { label: 'For Schools', href: '/schools' },
  { label: 'Philosophy', href: '/philosophy' },
]
const current = Astro.url.pathname
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-md border-b border-neutral-100">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="flex items-center justify-between h-16">
      <a href="/" class="flex-shrink-0" aria-label="Optio home">
        <img src="/images/OptioLogo-FullColor.svg" alt="Optio" class="h-8" width="120" height="32" />
      </a>

      <div class="hidden md:flex items-center gap-1">
        {links.map((link) => (
          <a
            href={link.href}
            class={`px-4 py-2 rounded-lg text-sm font-semibold transition-colors ${
              current === link.href || current.startsWith(link.href + '/')
                ? 'text-optio-purple bg-optio-purple/10'
                : 'text-neutral-500 hover:text-neutral-900 hover:bg-neutral-50'
            }`}
          >
            {link.label}
          </a>
        ))}
      </div>

      <div class="hidden md:flex items-center gap-3">
        <a
          href={appLink('/login')}
          data-track="nav_login"
          class="text-sm font-semibold text-neutral-700 hover:text-optio-purple transition-colors px-3 py-2"
        >
          Login
        </a>
        <a href="/academy#free-class" data-track="nav_free_class" class="btn-primary">
          Try a free class
        </a>
      </div>

      <button
        id="nav-toggle"
        class="md:hidden p-2 rounded-lg text-neutral-500 hover:text-neutral-900 hover:bg-neutral-50"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="nav-mobile"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <div id="nav-mobile" hidden class="md:hidden bg-white border-t border-neutral-100 px-4 py-3">
    {links.map((link) => (
      <a href={link.href} class="block px-4 py-3 rounded-lg text-sm font-semibold text-neutral-700 hover:bg-neutral-50">
        {link.label}
      </a>
    ))}
    <div class="pt-3 mt-2 border-t border-neutral-100 flex flex-col gap-2">
      <a href={appLink('/login')} data-track="nav_login" class="block text-center px-4 py-3 rounded-lg text-sm font-semibold text-neutral-700 hover:bg-neutral-50">
        Login
      </a>
      <a href="/academy#free-class" data-track="nav_free_class" class="btn-primary w-full">
        Try a free class
      </a>
    </div>
  </div>
</nav>

<script>
  const toggle = document.getElementById('nav-toggle')
  const menu = document.getElementById('nav-mobile')
  toggle?.addEventListener('click', () => {
    const open = menu!.hidden
    menu!.hidden = !open
    toggle.setAttribute('aria-expanded', String(open))
  })
</script>
