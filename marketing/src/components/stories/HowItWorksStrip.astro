---
/**
 * The three steps, one line each, for a visitor who arrived from a search
 * and has never heard of Optio. Same copy as /academy, from one file.
 */
import { HOW_IT_WORKS } from '../../data/howItWorks'

export interface Props {
  class?: string
}
const { class: className = '' } = Astro.props
---

<aside class={`rounded-2xl border border-optio-purple/15 bg-optio-purple/5 px-5 py-5 sm:px-6 ${className}`} aria-labelledby="how-this-works">
  <p id="how-this-works" class="text-xs font-semibold uppercase tracking-wider text-optio-purple mb-3">How this works</p>
  <ol class="grid gap-3 sm:grid-cols-3">
    {HOW_IT_WORKS.map((step, i) => (
      <li class="flex items-start gap-3">
        <span class="flex-shrink-0 w-7 h-7 rounded-full bg-optio-purple text-white flex items-center justify-center text-xs font-bold" aria-hidden="true">{i + 1}</span>
        <span>
          <span class="block text-sm font-bold text-neutral-900">{step.title}</span>
          <span class="block text-sm text-neutral-500 font-medium leading-snug">{step.body}</span>
        </span>
      </li>
    ))}
  </ol>
  <p class="mt-3 text-sm text-neutral-500 font-medium">
    <a href="/academy#how-it-works" class="text-optio-purple font-semibold hover:underline">More about Optio Academy</a>
  </p>
</aside>
