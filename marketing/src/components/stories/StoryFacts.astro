---
/**
 * The facts of a story as a definition list: the school, the grade, the
 * subject, the activity. Plain <dl> so an answer engine reads label and value
 * as a pair. No credit, no XP, no dates: those belong to the receipt in
 * "What it counted for", once, where the explainer can say what they mean.
 */
import type { Story } from '../../data/stories.schema'
import { subjectSlug, subjectUrl, SETTING_LABEL, GRADE_BAND_LABEL } from '../../lib/stories'

export interface Props {
  story: Story
  /** Subjects with a hub page; those render as links. */
  hubSlugs?: Set<string>
  class?: string
}
const { story, hubSlugs = new Set<string>(), class: className = '' } = Astro.props
const multi = story.subject_split.length > 1
const school = SETTING_LABEL[story.student.setting]
const grade = story.student.grade_band ? GRADE_BAND_LABEL[story.student.grade_band] : null
---

<dl class={`grid grid-cols-2 sm:grid-cols-4 gap-x-6 gap-y-4 text-sm ${className}`}>
  {story.student.label && (
    <div>
      <dt class="text-[11px] uppercase tracking-wider text-neutral-500 font-semibold">Student</dt>
      <dd class="font-semibold text-neutral-900">{story.student.label}</dd>
    </div>
  )}
  <div>
    <dt class="text-[11px] uppercase tracking-wider text-neutral-500 font-semibold">School</dt>
    <dd class="font-semibold text-neutral-900">{school}</dd>
  </div>
  {grade && (
    <div>
      <dt class="text-[11px] uppercase tracking-wider text-neutral-500 font-semibold">Grade</dt>
      <dd class="font-semibold text-neutral-900">{grade}</dd>
    </div>
  )}
  <div>
    <dt class="text-[11px] uppercase tracking-wider text-neutral-500 font-semibold">{multi ? 'Subjects' : 'Subject'}</dt>
    <dd class="font-semibold text-neutral-900">
      {multi ? (
        <ul class="space-y-0.5">
          {story.subject_split.map((s) => {
            const slug = s.subject === story.subject ? story.subject_slug : subjectSlug(s.subject)
            return (
              <li>
                {hubSlugs.has(slug) ? <a href={subjectUrl(slug)} class="text-optio-purple hover:underline">{s.subject}</a> : s.subject}
              </li>
            )
          })}
        </ul>
      ) : hubSlugs.has(story.subject_slug) ? (
        <a href={subjectUrl(story.subject_slug)} class="text-optio-purple hover:underline">{story.subject}</a>
      ) : (
        story.subject
      )}
    </dd>
  </div>
  <div>
    <dt class="text-[11px] uppercase tracking-wider text-neutral-500 font-semibold">Activity</dt>
    <dd class="font-semibold text-neutral-900">{story.activity.label}</dd>
  </div>
</dl>
