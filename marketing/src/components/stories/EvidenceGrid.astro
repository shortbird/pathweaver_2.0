---
/**
 * What the student submitted. Images go through astro:assets (resized,
 * srcset, lazy). Quotes are blockquotes. Videos and documents are links: the
 * public story bucket holds images only, so those URLs are always external.
 */
import { Image } from 'astro:assets'
import type { EvidenceItem } from '../../data/stories.schema'

export interface Props {
  items: EvidenceItem[]
  class?: string
}
const { items, class: className = '' } = Astro.props

const images = items.filter((i) => i.type === 'image' && i.url)
const quotes = items.filter((i) => i.type === 'quote' && i.caption)
const links = items.filter((i) => (i.type === 'video' || i.type === 'document') && i.url)
const wide = images.length === 1
---

<div class={`space-y-8 ${className}`}>
  {images.length > 0 && (
    <ul class={`grid gap-5 ${wide ? 'grid-cols-1' : 'grid-cols-1 sm:grid-cols-2'}`}>
      {images.map((item) => {
        const sized = Boolean(item.width && item.height)
        return (
          <li>
            <figure class="rounded-2xl border border-neutral-100 bg-neutral-50 overflow-hidden">
              <div class={`overflow-hidden ${wide ? 'max-h-[36rem]' : 'aspect-[4/3]'}`}>
                {sized ? (
                  <Image
                    src={item.url!}
                    alt={item.alt ?? ''}
                    width={item.width!}
                    height={item.height!}
                    widths={[480, 800, 1200]}
                    sizes={wide ? '(min-width: 768px) 720px, 100vw' : '(min-width: 640px) 360px, 100vw'}
                    class="w-full h-full object-contain"
                  />
                ) : (
                  <Image
                    src={item.url!}
                    alt={item.alt ?? ''}
                    inferSize
                    widths={[480, 800, 1200]}
                    sizes={wide ? '(min-width: 768px) 720px, 100vw' : '(min-width: 640px) 360px, 100vw'}
                    class="w-full h-full object-contain"
                  />
                )}
              </div>
              {item.caption && (
                <figcaption class="px-4 py-3 text-sm text-neutral-500 font-medium border-t border-neutral-100 bg-white">{item.caption}</figcaption>
              )}
            </figure>
          </li>
        )
      })}
    </ul>
  )}

  {quotes.map((item) => (
    <blockquote class="border-l-4 border-optio-purple/30 pl-5 italic text-neutral-700 font-medium leading-relaxed">
      <p>{item.caption}</p>
      <footer class="not-italic text-xs text-neutral-500 font-semibold uppercase tracking-wider mt-2">From the student's submission</footer>
    </blockquote>
  ))}

  {links.length > 0 && (
    <ul class="space-y-3">
      {links.map((item) => {
        const label = item.caption || item.alt || (item.type === 'video' ? 'Watch the video' : 'Open the document')
        return (
          <li>
            <a href={item.url!} rel="noopener" target="_blank" class="group flex items-center gap-4 rounded-2xl border border-neutral-100 bg-white p-3 hover:border-optio-purple/40 transition-colors">
              {item.type === 'video' && item.thumb_url ? (
                <span class="w-28 aspect-video rounded-lg overflow-hidden bg-neutral-50 flex-shrink-0">
                  <Image src={item.thumb_url} alt="" inferSize widths={[224]} sizes="112px" class="w-full h-full object-cover" />
                </span>
              ) : (
                <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-optio-purple/10 text-optio-purple flex-shrink-0" aria-hidden="true">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                    {item.type === 'video' ? (
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                    ) : (
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    )}
                  </svg>
                </span>
              )}
              <span class="text-sm font-semibold text-neutral-900 group-hover:text-optio-purple transition-colors">{label}</span>
            </a>
          </li>
        )
      })}
    </ul>
  )}
</div>
