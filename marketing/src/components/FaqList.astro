---
/**
 * FAQ accordion using native <details>: readable with no JavaScript at all,
 * and the full answer text is in the HTML for crawlers.
 */
export interface Props {
  faqs: { q: string; a: string }[]
}
const { faqs } = Astro.props
---

<div class="divide-y divide-neutral-100">
  {faqs.map((f, i) => (
    <details class="group py-2" open={i === 0}>
      <summary class="flex items-center justify-between gap-4 py-3 cursor-pointer list-none text-lg font-semibold text-neutral-900 hover:text-optio-purple transition-colors [&::-webkit-details-marker]:hidden">
        {f.q}
        <svg
          class="w-5 h-5 text-neutral-400 flex-shrink-0 transition-transform group-open:rotate-180"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </summary>
      <p class="pb-4 text-neutral-500 leading-relaxed font-medium">{f.a}</p>
    </details>
  ))}
</div>
