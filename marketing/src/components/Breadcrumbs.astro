---
/**
 * Visible breadcrumb trail. Pair it with breadcrumbNode() from
 * src/data/schema.ts in the page's JSON-LD so the markup and the structured
 * data list the same trail. The last item is the current page and is not a
 * link.
 */
import type { Crumb } from '../data/schema'

export interface Props {
  items: Crumb[]
  class?: string
}
const { items, class: className = '' } = Astro.props
const last = items.length - 1
---

<nav aria-label="Breadcrumb" class={`text-xs font-semibold text-neutral-500 ${className}`}>
  <ol class="flex flex-wrap items-center gap-x-1.5 gap-y-1">
    {items.map((item, i) => (
      <li class="flex items-center gap-x-1.5">
        {i < last ? (
          <a href={item.href} class="hover:text-optio-purple transition-colors">{item.name}</a>
        ) : (
          <span aria-current="page" class="text-neutral-900 line-clamp-1">{item.name}</span>
        )}
        {i < last && (
          <svg class="w-3 h-3 text-neutral-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        )}
      </li>
    ))}
  </ol>
</nav>
