---
/**
 * The receipt: the site's signature visual. A real-life activity on top, the
 * transcript row it became underneath. Matches the "It Counted" ad creative:
 * activity, then receipt. Used on Home, Academy, and every lander.
 */
import { RECEIPT_ICON_PATHS } from '../data/receipt-icons'

export interface Props {
  activity: string
  course: string
  credit: string
  status?: string
  icon?: 'ball' | 'controller' | 'music' | 'brush' | 'flask' | 'heart' | 'run' | 'pan'
  /** Photo of the activity; when set it becomes the card's header and replaces the icon */
  image?: string
  class?: string
}
const { activity, course, credit, status = 'Earned', icon = 'ball', image, class: className = '' } = Astro.props

// An optional "media" slot does the same job as `image` with any markup, so
// a story page can put an optimized <Image> from astro:assets in the header.
// `image` wins when both are given; the icon shows only when neither is.
const hasMedia = Astro.slots.has('media')
const showHeader = Boolean(image) || hasMedia

const icons = RECEIPT_ICON_PATHS
---

<figure class={`bg-white rounded-2xl border border-neutral-100 shadow-lg overflow-hidden h-full flex flex-col ${className}`}>
  {image ? (
    <div class="aspect-[16/9] overflow-hidden">
      <img src={image} alt={activity} class="w-full h-full object-cover" loading="lazy" />
    </div>
  ) : hasMedia ? (
    <div class="aspect-[16/9] overflow-hidden">
      <slot name="media" />
    </div>
  ) : null}
  <!-- The real-life activity. flex-1 keeps every card's transcript block
       bottom-aligned when activity text wraps to a second line. -->
  <div class="flex items-center gap-3 px-5 py-4 flex-1">
    {!showHeader && (
      <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-optio-purple/10 text-optio-purple flex-shrink-0" aria-hidden="true">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d={icons[icon]} />
        </svg>
      </span>
    )}
    <p class="font-semibold text-neutral-900">{activity}</p>
  </div>

  <!-- The transcript row it became -->
  <div class="border-t border-dashed border-neutral-300 bg-neutral-50/60 px-5 pt-3 pb-4">
    <p class="text-[10px] uppercase tracking-widest text-neutral-500 font-semibold mb-2">
      Official transcript &middot; Optio Academy
    </p>
    <!-- Fixed two-line row so every card is the same height: course + chip,
         then credit + status. Never let the course name wrap. -->
    <div class="bg-white rounded-lg border-l-4 border-l-optio-pink border border-neutral-100 px-4 py-3">
      <div class="flex items-center justify-between gap-2 mb-1.5">
        <span class="font-semibold text-neutral-900 text-sm whitespace-nowrap truncate">{course}</span>
        <span class="px-2 py-0.5 bg-optio-purple text-white text-[9px] font-bold rounded-full tracking-wider flex-shrink-0">OPTIO</span>
      </div>
      <div class="flex items-center justify-between gap-2">
        <span class="text-sm text-neutral-500 font-medium whitespace-nowrap">{credit}</span>
        <span class="inline-flex items-center gap-1 text-sm font-semibold text-green-700 whitespace-nowrap">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          {status}
        </span>
      </div>
    </div>
  </div>
</figure>
