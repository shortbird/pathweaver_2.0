    "react-hook-form": "^7.87.0",
    "react-hot-toast": "^2.4.1",
    "react-markdown": "^10.1.0",
    "react-masonry-css": "^1.0.16",
    "react-pdf": "^9.2.1",
    "react-router-dom": "^6.24.1",
    "recharts": "^2.15.4",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@sentry/vite-plugin": "^2.23.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.0.16",
    "autoprefixer": "^10.5.4",
    "happy-dom": "^20.12.0",
    "jest-axe": "^10.0.0",
    "jsdom": "27.3.0",
    "postcss": "^8.5.26",
    "rollup-plugin-visualizer": "^5.12.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.4",
    "vite": "^7.3.0",
    "vitest": "^4.0.16",
    "vitest-axe": "^0.1.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node --max-old-space-size=4096 node_modules/vite/bin/vite.js build && (cp public/_redirects dist/_redirects 2>/dev/null || true)",
    "build:analyze": "node --max-old-space-size=4096 node_modules/vite/bin/vite.js build --mode analyze && (cp public/_redirects dist/_redirects 2>/dev/null || true)",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ],
    "rules": {
      "no-console": [
        "error",
        {
          "allow": [
            "warn",
            "error"
          ]
        }
      ],
      "no-restricted-syntax": [
        "error",
        {
          "selector": "CallExpression[callee.object.name='localStorage'][callee.property.name='setItem'][arguments.0.value=/^(access_token|refresh_token|app_access_token|app_refresh_token|user|original_admin_token|masquerade_token|session_encryption_key)$/]",
          "message": "C2 security: never persist auth tokens, the user object, or the legacy encryption key in localStorage. Tokens live in memory + httpOnly cookies via tokenStore (services/api.js)."
        }
      ]
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "linkify-it": "^5.0.2"
  }
}
