    "axios": "^1.20.0",
    "canvas-confetti": "^1.9.4",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.14",
    "focus-trap-react": "^11.0.4",
    "framer-motion": "^12.23.22",
    "html2pdf.js": "^0.14.0",
    "pdf-lib": "^1.17.1",
