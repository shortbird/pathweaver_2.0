    "@tanstack/react-query": "^5.102.8",
    "@techstark/opencv-js": "^5.0.0-release.1",
    "@tiptap/extension-link": "^3.30.6",
    "@tiptap/extension-placeholder": "^3.30.6",
    "@tiptap/extension-text-align": "^3.30.6",
